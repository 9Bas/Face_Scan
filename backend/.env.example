# Face Scan AI backend — environment variables.
# Copy to .env and fill in real values.

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Supabase (use the SERVICE ROLE key — server side only, bypasses RLS) ---
SUPABASE_URL=https://htgmakeuytiknkumxgii.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=sb_publishable_G_JyjQD6qiNvOb73Qzmy1Q_fw5JGuhC
STORAGE_BUCKET=photos

# --- InsightFace ---
FACE_PACK=buffalo_l
FACE_CTX_ID=-1
FACE_DET_SIZE_CSV=640,640
FACE_MIN_DETECTION_CONFIDENCE=0.5
FACE_MIN_SIZE=32
FACE_TOP_K=30
FACE_MATCH_MAX_DISTANCE=0.6
INDEX_BATCH_SIZE=8

# --- Security ---
# Set a random string to require it on /api/faces/index via X-API-Key header.
# Empty = open (dev only).
INDEX_API_KEY=

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS_CSV=*
