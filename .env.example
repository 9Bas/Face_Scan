# =============================================================================
# Frontend (Vite) — PUBLIC, safe to expose.
#   Only Supabase URL + anon key + worker URL belong here.
#   NEVER put service role keys or R2 secrets in this file.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WORKER_URL=

# =============================================================================
# Cloudflare Worker — server-side SECRETS.
#   Live inside Cloudflare (Workers > Settings > Variables) or a local
#   `.dev.vars` file inside the worker/ folder. NEVER commit `.dev.vars`.
# =============================================================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ACCOUNT_ID=

# Leave everything below this line empty — these notes are for the worker
# only and are not read by Vite.